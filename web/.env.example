# Opcional. Sin .env el front busca el back solo en el puerto 8000 de la misma máquina
# (http://localhost:8000 o la IP desde la que abres la app), y si no contesta usa datos de ejemplo.
# Cópialo a .env (Copy-Item .env.example .env) solo si el back corre en OTRA computadora:
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
# VITE_API_URL=off   -> la app funciona sola con los datos de ejemplo, sin buscar el back
