# Copia este archivo como .env (Copy-Item .env.example .env) y cambia la contraseña.
# .env NUNCA se sube al repo.

# Vacío = la API arranca sin base de datos (alertas, cola y demo viven en memoria)
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASENA@localhost:5432/astrohealth
FRONT_ORIGIN=http://localhost:5173

# Modo demo
DEMO_SEGUNDOS_POR_DIA=5
DEMO_RETRASO_VISIBLE=true
ENTORNO_INICIAL=nave
